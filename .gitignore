# Configurazione locale
config.php

# Database e sidecar
*.db
*.db-shm
*.db-wal

# Credenziali Basic Auth
.htpasswd

# Poligono di copertura reale (usare polygons.example.json come base)
monitor/polygons.json

# Override locale dei priori (usare priors.example.json come base)
monitor/priors.json

# Python
__pycache__/
*.pyc
venv/
.venv/

# Sistema
.DS_Store

# Cache silhouette (rigenerabile con download_silhouettes.php)
webapp/silhouettes/*
!webapp/silhouettes/.gitkeep

# Loghi compagnia VRS OperatorFlags (rigenerabili con download_opflags.php)
webapp/opflags/*
!webapp/opflags/.gitkeep

# Bandiere nazione SVG (set esterno; fallback emoji se assenti)
webapp/flags/*
!webapp/flags/.gitkeep

# Sessioni e utenti (mai nel repo pubblico; nel privato auth.db e' incluso a parte)
webapp/sessions/*
!webapp/sessions/.gitkeep
