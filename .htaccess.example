# Flight Anomaly Monitor - .htaccess della root della webapp.
# Copiare in .htaccess dove sono serviti i .php.
#
# Il portale e' PUBBLICO in lettura: elenco eventi, dettaglio, statistiche e API
# non richiedono autenticazione. L'accesso alle azioni sui preferiti e' gestito
# dall'applicazione (auth.php: sessione + ruoli collaboratore/admin). Creare il
# primo utente con:  php auth_useradd.php <nome> admin

# Nega l'accesso diretto via HTTP a database, dump SQL, config, include e sessioni.
<FilesMatch "\.(db|db-wal|db-shm|sqlite|sqlite3|sql)$">
    Require all denied
</FilesMatch>
# File di solo include (definiscono funzioni, non producono output) e script CLI.
# Aggiornare questo elenco quando se ne aggiungono: un include raggiungibile non
# espone nulla oggi, ma non deve diventare una sorpresa domani.
<FilesMatch "^(config\.php|config\.sample\.php|auth\.php|favorites_lib\.php|ai_lib\.php|diary_lib\.php|csrf\.php|auth_useradd\.php|diary_build\.php|priors\.json)$">
    Require all denied
</FilesMatch>
# Artefatti di deployment: unit systemd, script, esempi. Rivelano percorsi,
# utente di esecuzione e configurazione del demone.
<FilesMatch "\.(service|sh|sample|example|yml|yaml|ini|conf|log)$">
    Require all denied
</FilesMatch>

# La cartella sessions/ e db/ hanno un proprio .htaccess deny-all
# (deploy/htaccess-db.example / htaccess-sessions.example).

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    # 'unsafe-inline' necessario: <script> inline, handler onclick/onsubmit,
    # attributi style=. view.php carica Leaflet da unpkg.com con SRI.
    # img-src deve elencare il server dei tile usato da view.php: se si cambia
    # fornitore di mappa, va aggiornato qui o la mappa resta bianca.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https://server.arcgisonline.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>
